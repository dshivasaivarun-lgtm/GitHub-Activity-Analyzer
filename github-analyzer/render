services:
  - type: web
    name: github-analyzer-api
    runtime: python
    rootDir: backend
    buildCommand: pip install -r requirements.txt --only-binary=:all:
    startCommand: uvicorn app.main:app --host 0.0.0.0 --port $PORT
    envVars:
      - key: GITHUB_TOKEN
        sync: false
      - key: DATABASE_URL
        value: sqlite:///./analyzer.db
      - key: CACHE_TTL_SECONDS
        value: 3600
      - key: PYTHON_VERSION
        value: 3.11.0
